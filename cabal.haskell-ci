-- Hand edits belong here rather than in the generated file, where a plain
-- regenerate drops them without a word.
github-patches: .github/haskell-ci.patch

-- Switched off with an empty version range: the warning fires on matches GHC
-- cannot see are exhaustive (adding a dummy pattern only draws the opposite
-- complaint), so -Werror on it fails CI on correct code.
error-incomplete-patterns: <0
